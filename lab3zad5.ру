# Вводим количество чисел n и число для проверки
try:
    n: int = int(input("Сколько первых чисел Фибоначчи вывести (n): "))
    if n <= 0:
        print("Ошибка: n должно быть натуральным числом (> 0).")
    else:
        # Выводим первые n чисел Фибоначчи с помощью цикла for
        fib_list: list[int] = []
        a: int = 0
        b: int = 1
        for _ in range(n):
            fib_list.append(a)
            a, b = b, a + b
        print(f"Первые {n} чисел Фибоначчи:", fib_list)

        # Проверяем принадлежность введённого числа ряду Фибоначчи
        target: int = int(input("Введите число для проверки принадлежности: "))
        if target < 0:
            print(f"Число {target} НЕ принадлежит ряду Фибоначчи.")
        else:
            x: int = 0
            y: int = 1
            while x < target:
                x, y = y, x + y
            if x == target:
                print(f"Число {target} принадлежит ряду Фибоначчи.")
            else:
                print(f"Число {target} НЕ принадлежит ряду Фибоначчи.")
except ValueError:
    print("Ошибка: введите целое число.")
