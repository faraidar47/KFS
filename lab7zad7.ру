import math

class Vector2D:
    """Класс двумерного вектора с инкапсуляцией координат."""

    def __init__(self, x: float = 0.0, y: float = 0.0) -> None:
        self.x = x
        self.y = y

    @property
    def x(self) -> float:
        return self.__x

    @x.setter
    def x(self, value: float) -> None:
        self.__x = float(value)

    @property
    def y(self) -> float:
        return self.__y

    @y.setter
    def y(self, value: float) -> None:
        self.__y = float(value)

    def __add__(self, other: "Vector2D") -> "Vector2D":
        return Vector2D(self.__x + other.__x, self.__y + other.__y)

    def __sub__(self, other: "Vector2D") -> "Vector2D":
        return Vector2D(self.__x - other.__x, self.__y - other.__y)

    def length(self) -> float:
        return math.hypot(self.__x, self.__y)

    def dot(self, other: "Vector2D") -> float:
        return self.__x * other.__x + self.__y * other.__y

    def __str__(self) -> str:
        return f"({self.__x:g}, {self.__y:g})"

def read_vector(name: str) -> Vector2D:
    x, y = map(float, input(f"Введите координаты {name} (x y): ").split())
    return Vector2D(x, y)

def main() -> None:
    try:
        v1 = read_vector("v1")
        v2 = read_vector("v2")
        print(f"v1 = {v1}, длина |v1| = {v1.length():.2f}")
        print(f"v2 = {v2}, длина |v2| = {v2.length():.2f}")
        print(f"Сумма v1 + v2 = {v1 + v2}")
        print(f"Разность v1 - v2 = {v1 - v2}")
        print(f"Скалярное произведение v1 · v2 = {v1.dot(v2):g}")
    except ValueError:
        print("Ошибка: введите ровно два числа через пробел.")

if __name__ == "__main__":
    main()
